# ==============================================================================
# MindSahaay Platform - Environment Configuration Template
# Copy this file to .env or .env.local for local frontend development.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Client Environment Variables (Vite - Exposed to browser)
# ------------------------------------------------------------------------------

# Supabase Project URL (Required outside demo mode)
# Points to your Supabase cloud project or local Supabase instance.
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key (Required outside demo mode)
# Public by design; access is strictly scoped by Row Level Security (RLS) policies.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Edge Functions Slug / Base Path (Default: "server")
# Directs API requests to https://<project>.supabase.co/functions/v1/<slug>
VITE_FUNCTIONS_SLUG=server

# Demo / Offline Presentation Mode Flag ("true" or "false")
# When set to true, permits running the app with mock/in-memory data when credentials are unset.
VITE_DEMO_MODE=false

# Optional Supabase Project ID override
# VITE_SUPABASE_PROJECT_ID=your-project-id

# ------------------------------------------------------------------------------
# Server-Side Environment Variables (Supabase Edge Runtime / Vault Secrets ONLY)
# DO NOT prefix these with VITE_ and DO NOT expose them to the browser client.
# Configure these in Supabase Dashboard (Project Settings -> Edge Functions Secrets)
# or via Supabase CLI (`supabase secrets set KEY=VALUE`).
# ------------------------------------------------------------------------------

# ANTHROPIC_API_KEY=sk-ant-api03-... # [server-only] Anthropic Claude Opus 5.5 API key for MindMate AI companion
# DAILY_API_KEY=da_...               # [server-only] Daily.co tele-consultation video room token generation API key
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8443,https://mindsahaay.org # [server-only] Comma-delimited CORS allowlist
